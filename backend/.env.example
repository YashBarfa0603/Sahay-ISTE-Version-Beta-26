# SAHAY (सहाय) Backend Environment Configuration
# Copy this file to .env and configure your local or production settings.

APP_NAME="SAHAY Backend API"
APP_VERSION="1.0.0"
DEBUG=False

# Tavily Search API (Optional for dynamic discovery; simulated fallback active if blank)
# Obtain key at: https://tavily.com
TAVILY_API_KEY=""

# Ollama AI Model (Qwen2.5 for natural language structuring)
# Install Ollama: https://ollama.com and run: ollama run qwen2.5
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:latest"

# Minimum similarity / result count threshold to avoid external Tavily search
CATALOGUE_MIN_RESULTS=3

# Firebase Service Account Credentials (Optional for local emulation)
# FIREBASE_CREDENTIALS_PATH="/path/to/firebase-service-account.json"
